# With Docker, scripts/install.sh writes .env for you (random passwords,
# owner token); this file documents what it holds. No credentials are supplied.
# POSTGRES_PASSWORD is the PostgreSQL superuser password. Compose gives it to
# the database, the one-shot migrate service and the maintenance scheduler
# (as PGPASSWORD, so any characters work), never to the API service.
POSTGRES_PASSWORD=
# Runtime role passwords: the API connects as throughline_app and throughline_reader.
THROUGHLINE_APP_PASSWORD=
THROUGHLINE_READER_PASSWORD=
THROUGHLINE_URL=http://127.0.0.1:8000
THROUGHLINE_TOKEN=
# The owner's IANA time zone (local days, schedules, owner-local times).
THROUGHLINE_TIMEZONE=UTC
# Docker: optional services to run (maintenance, connectors), comma separated.
COMPOSE_PROFILES=maintenance
# Docker: where the API is published (default 127.0.0.1:8000).
# THROUGHLINE_BIND=127.0.0.1
# THROUGHLINE_PORT=8000

# ---------------------------------------------------------------------------
# Everything below is optional. With none of it set Throughline makes no
# outbound call: keyword search works, meaning search reports "unavailable",
# and reranking, semantic matching and the controller use deterministic local
# implementations. With Docker Compose, put the ones you set in
# throughline.env (same KEY=value format, next to docker-compose.yml): the API
# and migrate services read it, and updates never overwrite it. Keep
# POSTGRES_PASSWORD out of it; it belongs in .env only.
# ---------------------------------------------------------------------------

# Egress allow-list. A model endpoint that is not loopback (127.0.0.0/8, ::1,
# localhost) is refused before any connection is opened unless its host is
# listed here. Comma or space separated; an entry is a host (any port) or
# host:port. This also applies to an embedding endpoint configured below.
# THROUGHLINE_EGRESS_ALLOW=api.example.com, models.example.net:8443

# Embeddings. Unset: remote once BASE_URL, MODEL and DIMENSIONS are all set,
# otherwise unavailable. "local": the built-in deterministic hash embedder
# (model local-hash-v1, no network, no cost; lexical, not a real model).
# "none": unavailable.
# "voyage", "gemini", "openrouter": that vendor's own interface (query and
# document input types; contextual chunks with voyage-context-4; batch jobs
# for historic loads with voyage and gemini). A vendor needs only its key and
# its host in THROUGHLINE_EGRESS_ALLOW (api.voyageai.com,
# generativelanguage.googleapis.com, openrouter.ai); MODEL, DIMENSIONS and
# PRICE_PER_MILLION default per vendor (voyage-4-large at 1024,
# gemini-embedding-2 at 1536; openrouter needs MODEL). docs/v11/embeddings.md.
# THROUGHLINE_EMBEDDING_PROVIDER=
# Vendor keys, used when THROUGHLINE_<KIND>_KEY is not set.
# VOYAGE_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OpenRouter routing preferences (JSON of its `provider` field). Default
# {"data_collection":"deny"}; "{}" sends none.
# THROUGHLINE_OPENROUTER_PROVIDER=
# OpenAI-compatible endpoint, up to and including /v1.
# THROUGHLINE_EMBEDDING_BASE_URL=
# THROUGHLINE_EMBEDDING_MODEL=
# Vector size, 1..16000. For the local embedder the default is 256. Changing
# the size of a model already in use needs a new model name.
# THROUGHLINE_EMBEDDING_DIMENSIONS=
# Bearer key for the endpoint, if it needs one.
# THROUGHLINE_EMBEDDING_KEY=
# Price in USD per million tokens, used for the ledger (default 0.02).
# THROUGHLINE_EMBEDDING_PRICE_PER_MILLION=0.02
# Seconds a search waits for the embedding of its query (default 5, at most
# 60). Worker batches always wait up to 60.
# THROUGHLINE_EMBEDDING_QUERY_TIMEOUT_S=5
# Seconds a query embedding stays cached (default 604800, one week).
# THROUGHLINE_EMBEDDING_QUERY_CACHE_TTL_S=604800
# Which channels are embedded is stored per channel, not here:
#   throughline embed channels --disable NAME
# Historic loads. "batch": the worker hands a backlog of at least BATCH_MIN
# texts to the vendor's batch interface (cheaper, answered within hours);
# "sync" (default): only `throughline embed backfill` does. Answered jobs are
# asked at most every BATCH_POLL_S seconds.
# THROUGHLINE_EMBEDDING_HISTORIC=sync
# THROUGHLINE_EMBEDDING_BATCH_MIN=500
# THROUGHLINE_EMBEDDING_BATCH_POLL_S=60
# Contextual models: estimated tokens of preceding text sent with each window
# of chunks (default 2000, at most 4000; 0 sends none).
# THROUGHLINE_EMBEDDING_CONTEXT_TOKENS=2000
# Most USD embedding spends in a calendar month at list price (unset: no cap),
# and an optional timestamp before which this month's spend is not counted.
# THROUGHLINE_EMBEDDING_MONTHLY_USD=5
# THROUGHLINE_EMBEDDING_BUDGET_SINCE=
# "off": no nearest-neighbour index is created (ranking stays exact).
# THROUGHLINE_EMBEDDING_INDEX=on

# Reranker, semantic model (api.match) and controller (librarian). Each
# *_PROVIDER is local (default), http, none or a vendor (rerank: voyage,
# openrouter; semantic and controller: openrouter, gemini). With http the kind
# reads its own BASE_URL, MODEL, KEY and PRICE_PER_MILLION (default 0).
# THROUGHLINE_RERANK_PROVIDER=local
# POST {BASE_URL}/rerank with {model, query, documents}.
# THROUGHLINE_RERANK_BASE_URL=
# THROUGHLINE_RERANK_MODEL=
# THROUGHLINE_RERANK_KEY=
# THROUGHLINE_RERANK_PRICE_PER_MILLION=0
# POST {BASE_URL}/chat/completions with JSON output.
# THROUGHLINE_SEMANTIC_PROVIDER=local
# THROUGHLINE_SEMANTIC_BASE_URL=
# THROUGHLINE_SEMANTIC_MODEL=
# THROUGHLINE_SEMANTIC_KEY=
# THROUGHLINE_SEMANTIC_PRICE_PER_MILLION=0
# THROUGHLINE_CONTROLLER_PROVIDER=local
# THROUGHLINE_CONTROLLER_BASE_URL=
# THROUGHLINE_CONTROLLER_MODEL=
# THROUGHLINE_CONTROLLER_KEY=
# THROUGHLINE_CONTROLLER_PRICE_PER_MILLION=0
# One chat endpoint for both: used by semantic and controller for whichever of
# their own four settings is not set. The shared key is sent only to the shared
# base URL: a kind with its own, different base URL needs its own _KEY.
# THROUGHLINE_MODEL_BASE_URL=
# THROUGHLINE_MODEL_MODEL=
# THROUGHLINE_MODEL_KEY=
# THROUGHLINE_MODEL_PRICE_PER_MILLION=0

# Synonyms for the local providers: a path to a JSON file, or inline JSON.
# {"canonical": ["word", ...]}, {"word": "canonical"} or [["canonical", "word"]].
# THROUGHLINE_LOCAL_SYNONYMS=

# How an owner token's asker that is not registered is treated: unrestricted
# (default) or deny.
# THROUGHLINE_UNKNOWN_ASKER=unrestricted
# Seconds a read waits for deferred thread maintenance (default 2).
# THROUGHLINE_READ_MATERIALIZE_WAIT_S=2
# Longest gap in seconds inside one detected visit (default 43200).
# THROUGHLINE_VISIT_MAX_GAP_S=43200

# Web interface (served under /ui/ by the API process; docs/web/backend.md).
# 0 disables the static shell; the /v1/web routes stay.
# THROUGHLINE_WEB=1
# One https origin the interface may load map tiles from (http only for a
# loopback host; anything else is ignored with a warning). Unset (default):
# the page makes no request to any other host.
# THROUGHLINE_WEB_TILE_ORIGIN=
# Requests that may wait in GET /v1/web/arrivals at the same time (default 16).
# THROUGHLINE_WEB_WAITERS=16

# Signing in to the web interface (docs/web/auth.md). With nothing set the
# interface offers username and password (accounts are made on the box with
# `throughline lib account create`) and pasting an access token.
# The address browsers use; needed behind a reverse proxy for provider callbacks.
# THROUGHLINE_PUBLIC_URL=https://throughline.example.com
# THROUGHLINE_AUTH_PASSWORD=1
# THROUGHLINE_AUTH_TOKEN=1
# External providers, comma separated ids. "authentik" is a preset; any other
# id with THROUGHLINE_AUTH_<ID>_KIND=oidc is a generic OpenID Connect provider.
# THROUGHLINE_AUTH_PROVIDERS=authentik
# Issuer as Authentik shows it: https://auth.example.com/application/o/<slug>/
# Redirect URI to register: <public url>/v1/auth/oidc/authentik/return
# THROUGHLINE_AUTH_AUTHENTIK_ISSUER=
# THROUGHLINE_AUTH_AUTHENTIK_CLIENT_ID=
# THROUGHLINE_AUTH_AUTHENTIK_CLIENT_SECRET=
# Only members of these groups may sign in (default: anyone the provider lets through).
# THROUGHLINE_AUTH_AUTHENTIK_ALLOWED_GROUPS=
# 1 (default): a first sign-in with a verified e-mail equal to an account's links it.
# THROUGHLINE_AUTH_AUTHENTIK_LINK_BY_EMAIL=1
# Session lifetimes: remembered ("stay signed in") and otherwise.
# THROUGHLINE_AUTH_SESSION_DAYS=30
# THROUGHLINE_AUTH_SESSION_HOURS=12

# The query helper beside the SQL editor (docs/web/assistant.md). local (the
# default) runs no model: a finder over recipes, channels, fields, people and
# full text, a rule table for Fix and a structural Explain. anthropic uses the
# Messages API; openai any OpenAI-compatible /chat/completions endpoint with
# tools (local servers included). The endpoint's host must be in
# THROUGHLINE_EGRESS_ALLOW unless it is loopback; spend goes to the ledger.
# THROUGHLINE_ASSISTANT_PROVIDER=local
# Model id (anthropic default claude-opus-5-5; required for openai).
# THROUGHLINE_ASSISTANT_MODEL=
# Endpoint (required for openai; anthropic default https://api.anthropic.com).
# THROUGHLINE_ASSISTANT_BASE_URL=
# Key. ANTHROPIC_API_KEY / OPENAI_API_KEY are used only for the vendor's own
# host over https (api.anthropic.com / api.openai.com), never for another
# endpoint.
# THROUGHLINE_ASSISTANT_API_KEY=
# What the model may see: schema (names, types, counts, errors) or samples
# (also at most 20 rows, cells clipped to 200 characters). Every model but the
# local helper defaults to schema, a loopback endpoint included (it may be a
# gateway to a vendor); samples here makes samples the default everywhere.
# THROUGHLINE_ASSISTANT_TIER=
# 1 states that the loopback endpoint's model runs on this machine: only then
# are sensitivity labels skipped (and samples the default). Leave it unset for
# a local gateway that forwards to a vendor.
# THROUGHLINE_ASSISTANT_MODEL_IS_LOCAL=
# Tool steps per run (1..32) and spend ceiling per run in USD (a run also stays
# within its token's max_model_cost, default 0.10, for the whole run).
# THROUGHLINE_ASSISTANT_MAX_STEPS=8
# THROUGHLINE_ASSISTANT_MAX_USD=0.50
# Helper spend one token may reach in any 24 hours, in USD (from the ledger).
# THROUGHLINE_ASSISTANT_DAILY_USD=5.00
# Wall-clock limit of a run (5..1800 s) and of one model request (5..600 s).
# THROUGHLINE_ASSISTANT_DEADLINE_S=300
# THROUGHLINE_ASSISTANT_TIMEOUT_S=120
# anthropic: effort (low, medium, high, xhigh, max; default medium) and the
# server-side refusal fallback (0 turns it off).
# THROUGHLINE_ASSISTANT_EFFORT=medium
# THROUGHLINE_ASSISTANT_FALLBACKS=1
# Output token limit of one turn, and USD per million input / output tokens
# (anthropic models are priced from a built-in table; openai defaults to 0).
# THROUGHLINE_ASSISTANT_MAX_TOKENS=16000
# THROUGHLINE_ASSISTANT_PRICE_IN=
# THROUGHLINE_ASSISTANT_PRICE_OUT=

# Infisical secret references (optional). Set a machine identity here (or in
# infisical.env with Docker Compose) and reference secrets instead of storing
# credentials in Throughline, e.g. OPENROUTER_API_KEY=infisical:OPENROUTER_API_KEY
# or "GITHUB_TOKEN": "infisical:/connectors/github/GITHUB_TOKEN" in connectors.json.
# See docs/infisical.md.
# INFISICAL_SITE_URL=https://app.infisical.com
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_TOKEN=
# INFISICAL_PROJECT_ID=
# INFISICAL_PROJECT_SLUG=
# INFISICAL_ENVIRONMENT=prod
# INFISICAL_SECRET_PATH=/
# INFISICAL_CACHE_TTL_S=300
# INFISICAL_TIMEOUT_S=15

# Development and tests only.
# THROUGHLINE_DEV=1 lets the runtime roles have empty passwords. Never set it
# on a deployment.
# THROUGHLINE_DEV=
# Full owner (superuser) connection string, for the command line outside
# compose. Compose sets it per service.
# THROUGHLINE_DATABASE_URL=
# Directory holding pg_dump and pg_restore when they are not on PATH.
# THROUGHLINE_PG_BIN=
# Administrative database the test suite creates its scratch databases from.
# THROUGHLINE_TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:54331/postgres
