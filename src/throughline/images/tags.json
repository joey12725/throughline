{
 "version": 2,
 "model": "siglip2-so400m-384",
 "notes": "Zero-shot kind and tags over SigLIP2 image vectors. A tag's margin is its best prompt's cosine minus the cosine of that prompt's template reference (references, by prefix; longest prefix wins). prob = sigmoid(logit_scale*margin + logit_bias); a tag is kept at prob >= its threshold (default_threshold) when the asset's kind is in its kinds list. Kind = softmax(kind_temperature * max prompt cosine + signal priors). Tune with `throughline lib images calibrate`.",
 "logit_scale": 117.0,
 "logit_bias": -2.3,
 "kind_temperature": 100.0,
